FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv && apt-get update && apt-get install -y --no-install-recommends binutils && rm -rf /var/lib/apt/lists/* && uv sync --frozen --no-dev && uv pip install pyinstaller

COPY main.py converter.py config.py ./

RUN uv run pyinstaller --onefile --name oai2proxy --strip main.py
