# Upstream OpenAI-compatible endpoint (required)
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sk-your-key-here

# Proxy server
PROXY_HOST=0.0.0.0
PROXY_PORT=8080

# Proxy entry auth (optional, empty = no auth required)
# Clients must send this key in the x-api-key header.
# PROXY_API_KEY=
